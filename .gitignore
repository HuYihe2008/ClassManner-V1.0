# 项目特定排除
!.gitkeep  # 如果需要保留空目录

# IDE
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
/Users

# 依赖目录
node_modules/
venv/
__pycache__/
.pytest_cache/



# 排除构建目录
dist/
build/
builder/
buileder/
out/
target/
*.exe
*.dll
*.so
*.egg-info/

# 日志文件
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 系统文件
.DS_Store
Thumbs.db
*.sqlite3

# 测试覆盖
coverage/
.nyc_output/

# 环境文件
.env
.env.local
.env.development
.env.production

# 包管理器文件
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# 临时文件
tmp/
temp/
*.tmp
*.bak


# 新增：忽略所有data目录
API/data/activeimages/*
API/data/excellentworks/*

# 修改：忽略data目录下的文件但保留目录结构
API/data/activeimages/**
!API/data/activeimages/.gitkeep
API/data/excellentworks/**
!API/data/excellentworks/.gitkeep
