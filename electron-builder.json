{
  "productName": "classmanerV1.0",
  "files": ["./electron/main.js", "./dist"],
  "extraFiles": ["./videos", "./cvideo"],
  "directories": {
    "output": "buileder",
    "buildResources": "build"
  },
  "publish": {
    "provider": "github",
    "releaseType": "release"
  },
  "mac": {
    "target": ["dmg"],
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "win": {
    "target": ["nsis"],
    "artifactName": "${productName}-${version}-${arch}.exe"
  },
  "linux": {
    "target": ["AppImage"],
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "category": "Development"
  }
}